# syntax=docker/dockerfile:1.7
#
# 运行时 Dockerfile。
#
# 底包：nixos kernel 层（scratch），即只有内核提供的执行环境，不含任何发行版用户态。
# 镜像只包含：
#   * smartdns 的 nixpkg（/nix/store 闭包：主程序 + ui 插件 + glibc + 裁剪后的 openssl + zlib）
#   * 必要的运行时文件（配置、wwwroot、CA certificates、timezone）
# 不包含：bash、busybox、apk、nix、gcc、coreutils。
#
# 用法：
#   docker buildx build -f Dockerfile.nix -t smartdns:build .
#   docker buildx build -f Dockerfile.nix.runtime --build-arg BUILD_IMAGE=smartdns:build -t smartdns:runtime .
#
ARG BUILD_IMAGE=smartdns:build

# 编译产物（nixpkgs）来源
FROM ${BUILD_IMAGE} AS nixpkgs

# 底包：nixos kernel 层，没有任何用户态工具
FROM scratch

# smartdns 的 nixpkg：/nix/store 闭包
COPY --from=nixpkgs /nix /nix
# 必要运行时文件：/usr/sbin/smartdns、/usr/lib/smartdns、/etc/smartdns、
# /usr/share/smartdns/wwwroot、/etc/ssl/certs、/usr/share/zoneinfo
COPY --from=nixpkgs /release/ /

# C.UTF-8 由 glibc 内建提供，不需要完整的 locale archive
ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt \
    SSL_CERT_DIR=/etc/ssl/certs

EXPOSE 53/udp 53/tcp 6080/tcp
VOLUME ["/etc/smartdns/", "/var/lib/smartdns/"]

CMD ["/usr/sbin/smartdns", "-f", "-x", "-p -"]
